---contains two additional columns (order_token and main_decline_reason) to facilitate testing

USE database ap_Raw_green;
USE WAREHOUSE ADHOC__XLARGE;
CREATE OR REPLACE TABLE  PERSONAL_OKASPERSKA.public.EV_APPLICATION_IDV AS
(
    WITH
        base     AS (
            SELECT order_detail_order_token                                                       AS order_token
                 , consumer_consumer_uuid                                                         AS consumer_uuid
                 , key_event_info_id
                 , order_detail_consumer_total_amount_amount
                 , event_info_event_time
                 , rejection_reason
                 , order_detail_merchant_merchant_id                                              AS merchant_id
                 , result
                 , TO_DATE(CONVERT_TIMEZONE('UTC', 'America/Los_Angeles', event_info_event_time)) AS application_date
            FROM ap_raw_green.green.raw_c_e_cl_idv_result
            WHERE par_region = 'US'
              AND application_date = '2025-04-01'
            QUALIFY ROW_NUMBER() OVER (PARTITION BY consumer_consumer_uuid, order_detail_order_token ORDER BY event_info_event_time DESC) = 1
                AND result = 'FAILED'
            )
      , aan      AS (
            SELECT consumer_uuid
                 , order_token
                 , batch_dttm
                 , SPLIT_PART(decline_reason_mapping, ';', 1) AS aan_1
                 , SPLIT_PART(decline_reason_mapping, ';', 2) AS aan_2
                 , SPLIT_PART(decline_reason_mapping, ';', 3) AS aan_3
                 , SPLIT_PART(decline_reason_mapping, ';', 4) AS aan_4
                 , decline_main_sub_reason
                 , decline_reason
            FROM ap_cur_crrskbr_g.curated_credit_risk_bureau.cl_send_aan_us_prod_history
            QUALIFY ROW_NUMBER() OVER (PARTITION BY consumer_uuid, order_token, decline_reason ORDER BY doc_id DESC) = 1
            )
      , dc_green AS (
            SELECT uuid
                 , id
                 , suburb
                 , state
                 , postcode
            FROM ap_raw_green.green.d_consumer
            WHERE country_code = 'US'
            )
      , dc_red   AS (
            SELECT id
                 , given_names
                 , surname
                 , date_of_birth
                 , address1
                 , address2
            FROM ap_raw_red_csmr.red.d_consumer__okasperska_DSL3_SV
            )
    SELECT 'Block'                                                                 AS partner_id
    ,base.order_token, 'NA' as decline_main_reason
         , CONCAT(base.order_token, '__', base.key_event_info_id)                  AS application_id
         , NULL                                                                    AS loan_account_number
         , base.consumer_uuid                                                      AS customer_id
         , dc_red.given_names                                                      AS first_name
         , dc_red.surname                                                          AS last_name
         , 'WIP'                                                                   AS ssn_or_fedid
         , dc_red.date_of_birth
         , dc_red.address1                                                         AS street_address1
         , dc_red.address2                                                         AS street_address2
         , dc_green.suburb                                                         AS city
         , dc_green.state
         , dc_green.postcode::VARCHAR                                              AS zipcode_plus_four
         , 'N/A'                                                                   AS ability_to_pay_measurement_value
         , 'N/A'                                                                   AS ability_to_pay_result
         , NULL                                                                    AS active_duty_flag
         , CASE WHEN base.rejection_reason = 'ADDRESS_ISSUE' THEN 'Y' ELSE 'N' END AS address_discrepancy_alert
         , aan.batch_dttm                                                          AS adverse_action_notice_date
         , aan.aan_1                                                               AS adverse_action_reason_1
         , aan.aan_2                                                               AS adverse_action_reason_2
         , aan.aan_3                                                               AS adverse_action_reason_3
         , aan.aan_4                                                               AS adverse_action_reason_4
         , YEAR(base.application_date) - YEAR(dc_red.date_of_birth)                AS applicant_age_at_time_of_application
         , NULL                                                                    AS amount_financed
         , base.application_date
         , base.application_date                                                   AS application_decision_date
         , 'Point of Sale'                                                         AS application_type
         , NULL                                                                    AS approved_loan_amount_or_initial_credit_limit
         , 'N/A'                                                                   AS campaign_name
         , 'Y'                                                                     AS cip_match_flag
         , NULL                                                                    AS credit_reporting_agency_supplier
         , 'N/A'                                                                   AS credit_score_exception_notice_date
         , NULL                                                                    AS customer_econsent_flag
         , 'N/A'                                                                   AS customer_requested_decline_reasons_flag
         , 'N/A'                                                                   AS date_customer_requested_decline_reasons
         , NULL                                                                    AS date_of_bureau_inquiry
         , 'N/A'                                                                   AS debt_to_income_ratio
         , 'APPLICATION DENIED'                                                    AS disposition_of_application
         , 'N/A'                                                                   AS employment_duration
         , NULL                                                                    AS fraud_alert_initial
         , NULL                                                                    AS fraud_alert_extended
         , 'N/A'                                                                   AS income_of_applicant
         , 'N/A'                                                                   AS income_of_joint_or_co_applicant
         , 'Fixed'                                                                 AS interest_rate_method
         , 'N/A'                                                                   AS name_of_joint_or_co_applicant
         , 'English'                                                               AS language_flag
         , NULL                                                                    AS loan_acceptance_date
         , 'N/A'                                                                   AS marketing_channel
         , merch.trading_name                                                      AS merchant
         , 'N/A'                                                                   AS mla_status
         , 'N/A'                                                                   AS mla_status_indicator_method
         , 'N/A'                                                                   AS non_cra_third_party_reason_for_decline
         , 'N/A'                                                                   AS non_cra_third_party_reason_for_decline2
         , CASE WHEN base.rejection_reason = 'OFAC_ISSUE' THEN 'Y' ELSE 'N' END    AS ofac_soft_hit
         , base.application_date                                                   AS ofac_check_date
         , 'N'                                                                     AS firm_offer_of_credit
         , 'N/A'                                                                   AS origination_fee
         , NULL                                                                    AS payment_amount
         , 'Monthly'                                                               AS payment_frequency
         , 'N/A'                                                                   AS payment_to_income_ratio
         , 'N/A'                                                                   AS pend_reason
         , 'N'                                                                     AS poc_flag
         , 'Apinstallment'                                                         AS product
         , 'N/A'                                                                   AS promotional_interest_rate
         , 'N/A'                                                                   AS promotional_interest_rate_duration
         , 'N/A'                                                                   AS requested_loan_amount
         , 'N/A'                                                                   AS same_as_cash_code
         , NULL                                                                    AS standard_account_apr
         , NULL                                                                    AS standard_interest_rate
         , NULL                                                                    AS term_length_in_months
         , NULL                                                                    AS credit_score_1
         , NULL                                                                    AS credit_score_1_pull_date
         , NULL                                                                    AS credit_score_1_key_factor_reason_1
         , NULL                                                                    AS credit_score_1_key_factor_reason_2
         , NULL                                                                    AS credit_score_1_key_factor_reason_3
         , NULL                                                                    AS credit_score_1_key_factor_reason_4
         , NULL                                                                    AS credit_score_1_key_factor_reason_5
         , 'N/A'                                                                   AS credit_score_2
         , 'N/A'                                                                   AS credit_score_2_pull_date
         , 'N/A'                                                                   AS credit_score_2_key_factor_reason_1
         , 'N/A'                                                                   AS credit_score_2_key_factor_reason_2
         , 'N/A'                                                                   AS credit_score_2_key_factor_reason_3
         , 'N/A'                                                                   AS credit_score_2_key_factor_reason_4
         , 'N/A'                                                                   AS credit_score_2_key_factor_reason_5
         , 'N/A'                                                                   AS credit_score_3
         , 'N/A'                                                                   AS credit_score_3_pull_date
         , 'N/A'                                                                   AS credit_score_3_key_factor_reason_1
         , 'N/A'                                                                   AS credit_score_3_key_factor_reason_2
         , 'N/A'                                                                   AS credit_score_3_key_factor_reason_3
         , 'N/A'                                                                   AS credit_score_3_key_factor_reason_4
         , 'N/A'                                                                   AS credit_score_3_key_factor_reason_5
         , NULL                                                                    AS fraud_score_1
         , NULL                                                                    AS fraud_score_2
         , 'N/A'                                                                   AS fraud_score_3
         , 'N/A'                                                                   AS fraud_score_4
         , 'N/A'                                                                   AS fraud_score_5
         , 'N/A'                                                                   AS fraud_score_6
         , 'N/A'                                                                   AS fraud_score_7
         , 'N/A'                                                                   AS fraud_score_8
         , 'N/A'                                                                   AS fraud_score_9
         , 'N/A'                                                                   AS fraud_score_10
       
       ----additional custom decision metrics
         , 'N/A'                                                                   AS PASSED_MINIMAL_COMPLIANCE_CRITERIA
         , 'N/A'                                                                   AS ESTABLISHED_RELATIONSHIP
         , 'N/A'                                                                   AS MAX_LATE_DAYS
         , 'N/A'                                                                   AS NUM_ORDERS_180D
         , 'N/A'                                                                   AS MONTHS_SINCE_RECENT_BANKRUPTCY_FILED
         , 'N/A'                                                                   AS TOTAL_INQUIRIES_30D
         , 'N/A'                                                                   AS TENURE
         , 'N/A'                                                                   AS TOTAL_OPEN_TRADES
         , 'N/A'                                                                   AS MONTHS_SINCE_OLDEST_TRADE
         , 'N/A'                                                                   AS TRADES_30D_PLUS_DELINQ
         , 'N/A'                                                                   AS MONTHS_SINCE_RECENT_NON_MEDICAL_COLLECTION
         , 'N/A'                                                                   AS MAX_BALANCE_TO_CREDIT_RATIO
         , 'N/A'                                                                   AS ACTIVE_LOAN_3M
         , 'N/A'                                                                   AS NUM_LOANS
         , 'N/A'                                                                   AS LAST_ORDER_DATE
         , 'N/A'                                                                   AS BASE_LAYER_APR_TERM_6
         , 'N/A'                                                                   AS BASE_LAYER_APR_TERM_12
         , 'N/A'                                                                   AS VELOCITY
         , 'N/A'                                                                   AS SEGMENT_PRIME_NEAR_PRIME_SUBPRIME
         , 'N/A'                                                                   AS RISK_EXPOSURE
         , 'N/A'                                                                   AS bp_c_nbr_of_instalment_with_payment_decline_rt_d180
         , 'N/A'                                                                   AS bp_c_nbr_of_days_since_latest_nsf
         , 'N/A'                                                                   AS EXPERIAN_NO_HIT
         , 'N/A'                                                                   AS DECEASED
         , 'N/A'                                                                   AS ACTIVE_BANKRUPTCY
         , 'N/A'                                                                   AS DECLINE_REASON
         , 'N/A'                                                                   AS VANTAGE_V3_SCORE
         , 'N/A'                                                                   AS CVI_SCORE
         , 'N/A'                                                                   AS RISK_INDICATOR
         , 'N/A'                                                                   AS AFTERPAY_RISK_MODEL_SCORE
         , 'N/A'                                                                   AS DOWNPAYMENT
         , 'N/A'                                                                   AS BASE_LAYER_APR
         , 'N/A'                                                                   AS STRATEGY_VERSION
         , 'N/A'                                                                   AS CL_TOTAL_OUTSTANDING_PRINCIPAL
         , 'N/A'                                                                   AS AP_INTERNAL_SCORE 
         , 'N/A'                                                                   AS G1
         , 'N/A'                                                                   AS G2
         , 'N/A'                                                                   AS G3
         , 'Pass'                                                                  AS LEXIS_NEXIS
    FROM base
             LEFT JOIN dc_green
                       ON base.consumer_uuid = dc_green.uuid
             LEFT JOIN dc_red
                       ON dc_green.id = dc_red.id
             LEFT JOIN aan
                       ON base.consumer_uuid = aan.consumer_uuid AND base.order_token = aan.order_token AND base.rejection_reason = aan.decline_reason
             LEFT JOIN ap_raw_green.green.d_merchant merch
                       ON base.merchant_id = merch.id
    );

CREATE OR REPLACE TABLE PERSONAL_OKASPERSKA.public.EV_APPLICATION_CRD AS
(
    WITH
        base      AS
            (
                SELECT order_token
                     , consumer_uuid
                     , key_event_info_id
                     , offers_loan_amount_amount
                     , key_event_info_event_time
                     , decision_status
                     , merchant_id
                     , offers_target_apr
                     , offers_term
                     , offers_eligibility
                     , credit_report_uuid
                     , test_group
                     , decline_main_reason
                     , decline_main_sub_reason
                     , CAST(CONVERT_TIMEZONE('UTC', 'America/Los_Angeles', DATEADD('MS', created_date, '1970-01-01')) AS DATE) AS created_time
                     , NULLIF(SPLIT_PART(offers_term, '\t', 1), '')::DECIMAL(10, 2)                                            AS term_1
                     , NULLIF(SPLIT_PART(offers_term, '\t', 2), '')::DECIMAL(10, 2)                                            AS term_2
                     , NULLIF(SPLIT_PART(offers_term, '\t', 3),'')::DECIMAL(10,2)                                              AS term_3
                     , SPLIT_PART(offers_eligibility, '\t', 1)                                                                 AS elgb_1
                     , SPLIT_PART(offers_eligibility, '\t', 2)                                                                 AS elgb_2
                     , SPLIT_PART(offers_eligibility, '\t', 3)                                                                 AS elgb_3
                     , NULLIF(SPLIT_PART(offers_target_apr, '\t', 1),'')::DECIMAL(10,6)                                        AS APR_1
                     , NULLIF(SPLIT_PART(offers_target_apr, '\t', 2),'')::DECIMAL(10,6)                                        AS APR_2
                     , NULLIF(SPLIT_PART(offers_target_apr, '\t', 3),'')::DECIMAL(10,6)                                        AS APR_3
                     , NULLIF(SPLIT_PART(offers_target_apr, '\t', 4),'')::DECIMAL(10,6)                                        AS APR_4
                     , NULLIF(SPLIT_PART(offers_target_apr, '\t', 5),'')::DECIMAL(10,6)                                        AS APR_5
                     , c_tenure
                     , c_day_late_pymt_max_cnt_180d_v2
                     , c_order_cnt_180d_v2
                     , active_cl_loan_in_3mo
                     , num_cl_active_orders
                     , cl_last_order_date
                     , bp_c_nbr_of_instalment_with_payment_decline_rt_d180                
                     , bp_c_nbr_of_days_since_latest_nsf
                     , offers_down_payment_amount_amount
                     , strategy_version_id
                     , cl_total_outstanding_principal
                     , BP_C_LATEST_CREDIT_MODEL_V2_SCORE
                     , SP_C_LATEST_CREDIT_MODEL_V2_SCORE
                     , NULLIF(JSON_EXTRACT_PATH_TEXT(model_score_detail,'scores.experian_credit_model_v1'),'')::DECIMAL(18,18) AS ec1_score
                     , CASE WHEN term_2 = 12 THEN elgb_2 WHEN term_3 = 12 THEN elgb_3 ELSE NULL END AS elgb_Term_12
                     , TO_DATE(CONVERT_TIMEZONE('UTC', 'America/Los_Angeles', key_event_info_event_time))                      AS application_date
                     , CONVERT_TIMEZONE('UTC', 'America/Los_Angeles', key_event_info_event_time)                               AS application_datetime
                FROM ap_cur_crdrisk_g.curated_credit_risk_green.consumer_lending_decision
                WHERE application_date = '2025-04-01'
                  AND order_token NOT IN (
                    SELECT order_token
                    FROM app_cash_3pr.afterpay.test_attempt_exclusions
                    )
                QUALIFY ROW_NUMBER() OVER (PARTITION BY order_token, consumer_uuid, decline_main_sub_reason ORDER BY key_event_info_event_time ASC) = 1
                )
      , dc_green  AS
            (
                SELECT uuid
                     , id
                     , suburb
                     , state
                     , postcode
                FROM ap_raw_green.green.d_consumer
                WHERE country_code = 'US'
                )
      , dc_red    AS
            (
                SELECT id
                     , given_names
                     , surname
                     , date_of_birth
                     , address1
                     , address2
                FROM ap_raw_red_csmr.red.d_consumer__okasperska_DSL3_SV
                )
      , bureau    AS
            (
                select *
                    ,case when experian_credit_check_details_is_deceased = false and experian_credit_check_details_is_bankruptcy = false then true else false end as min_compliance
                    ,nullif(JSON_EXTRACT_PATH_TEXT(experian_credit_check_details_premier_attributes,'P13_ALL9220'),'')::INTEGER as p13_all9220
                    ,nullif(JSON_EXTRACT_PATH_TEXT(experian_credit_check_details_premier_attributes,'P13_IQT9423'),'')::INTEGER as p13_iqt9423
                    ,nullif(JSON_EXTRACT_PATH_TEXT(experian_credit_check_details_premier_attributes,'P13_ALL0400'),'')::INTEGER as p13_all0400
                    ,nullif(JSON_EXTRACT_PATH_TEXT(experian_credit_check_details_premier_attributes,'P13_ALL8220'),'')::INTEGER as p13_all8220
                    ,nullif(JSON_EXTRACT_PATH_TEXT(experian_credit_check_details_premier_attributes,'P13_ALL2184'),'')::INTEGER as p13_all2184
                    ,nullif(JSON_EXTRACT_PATH_TEXT(experian_credit_check_details_premier_attributes,'P13_COL8192'),'')::INTEGER as p13_col8192
                    ,nullif(JSON_EXTRACT_PATH_TEXT(experian_credit_check_details_premier_attributes,'P13_ALL7120'),'')::INTEGER as p13_all7120
                    ,nullif(experian_credit_check_details_vantage_score,'')::INTEGER  as vantage_v3_score
                FROM ap_cur_crrskbr_g.prod.raw_r_e_credit_check_details bureau
                WHERE par_region = 'US'
                QUALIFY ROW_NUMBER() OVER (PARTITION BY key_credit_report_uuid ORDER BY event_info_event_time DESC) = 1
                )
      , aan       AS
            (
                SELECT consumer_uuid
                     , order_token
                     , batch_dttm
                     , SPLIT_PART(decline_reason_mapping, ';', 1) AS aan_1
                     , SPLIT_PART(decline_reason_mapping, ';', 2) AS aan_2
                     , SPLIT_PART(decline_reason_mapping, ';', 3) AS aan_3
                     , SPLIT_PART(decline_reason_mapping, ';', 4) AS aan_4
                     , decline_main_sub_reason
                FROM ap_cur_crrskbr_g.curated_credit_risk_bureau.cl_send_aan_us_prod_history
                QUALIFY ROW_NUMBER() OVER (PARTITION BY consumer_uuid, order_token, decline_main_sub_reason ORDER BY doc_id ASC) = 1
                )
      , idv       AS --- UNION of three tables is required because of a currently investigated issue where some successful IDV records from checkout flow were not populated in INSTANT_IDV. This is currently under investigation and if fixed then only IDV1 part will be needed.
            (
                WITH
                    idv_unioned AS (
                        SELECT b.order_token
                             , a.key_consumer_uuid                                                     AS consumer_uuid
                             , CONVERT_TIMEZONE('UTC', 'America/Los_Angeles', a.event_info_event_time) AS idv_date
                             , a.idv_check_result                                                         idv_check_result
                             , CASE WHEN a.risk_indicators ILIKE ANY ('%04%', '%11%', '%12%', '%14%', '%25%', '%30%', '%40%', '%50%', '%PA%', '%PO%', '%ZI%', '%CA%', '%CO%', '%CZ%', '%MO%', '%SD%', '%SR%', '%VA%') THEN 'ADDRESS_ISSUE'
                                    WHEN a.risk_indicators LIKE '%32%'                                                                                                                                                THEN 'OFAC_ISSUE'
                                    ELSE NULL
                               END                                                                     AS rejection_reason
                            , a.idv_score
                            , a.risk_indicators
                            , 1 as source_rnk
                        FROM ap_raw_green.green.raw_c_e_idv_instant_id a
                                 JOIN base                             b
                                      ON a.key_consumer_uuid = b.consumer_uuid
                        WHERE --idv_date <= application_datetime
                        CAST(CONVERT_TIMEZONE('UTC', 'America/Los_Angeles', a.event_info_event_time) AS TIMESTAMP) <= CAST(CONVERT_TIMEZONE('UTC', 'America/Los_Angeles', b.key_event_info_event_time) AS TIMESTAMP)
                        UNION
                        SELECT base.order_token ---sometimes consumer gets verified on a different token, information is not fed to generic table and it causes misses therefore we need any verification from CL table
                             , consumer_consumer_uuid
                             , CONVERT_TIMEZONE('UTC', 'America/Los_Angeles', a.event_info_event_time) AS idv_date
                             , CASE WHEN a.result = 'VERIFIED' THEN 'TRUE' ELSE 'FALSE' END
                             , rejection_reason
                             , null as idv_score
                             , null as risk_indicators
                             ,2 as source_rnk
                        FROM ap_raw_green.green.raw_c_e_cl_idv_result a
                                 JOIN base
                                      ON base.consumer_uuid = a.consumer_consumer_uuid -- this is only to get folks that had an attempt in credit risk so that we do not bring too much
                        WHERE par_region = 'US'
                          AND a.result = 'VERIFIED' ---only these are problematic here
                        UNION
                        -- static load of consumers that were missed in IDV process
                        SELECT base.order_token ---sometimes consumer gets verified on a different token, information is not fed to generic table and it causes misses therefore we need any verification from CL table
                             , a.consumer_account_uuid
                             , CONVERT_TIMEZONE('UTC', 'America/Los_Angeles', a.event_info_event_time) AS idv_date
                             , CASE WHEN a.idv_check_result = 'VERIFIED' THEN 'TRUE' ELSE 'FALSE' END  AS idv_check_result
                             , CASE WHEN a.risk_indicators ILIKE ANY ('%04%', '%11%', '%12%', '%14%', '%25%', '%30%', '%40%', '%50%', '%PA%', '%PO%', '%ZI%', '%CA%', '%CO%', '%CZ%', '%MO%', '%SD%', '%SR%', '%VA%') THEN 'ADDRESS_ISSUE'
                                    WHEN a.risk_indicators LIKE '%32%'                                                                                                                                                THEN 'OFAC_ISSUE'
                                    ELSE NULL
                               END                                                                     AS rejection_reason
                               , null as idv_score
                               , a.risk_indicators
                               , 3 as source_rnk
                        FROM app_cash_3pr.afterpay.ev_idv_static a
                                 JOIN base
                                      ON base.consumer_uuid = a.consumer_account_uuid
                        )
                SELECT order_token
                     , consumer_uuid
                     , idv_date
                     , idv_check_result
                     , rejection_reason
                     , idv_score
                     , risk_indicators
                     , source_rnk
                FROM idv_unioned
                QUALIFY ROW_NUMBER() OVER (PARTITION BY consumer_uuid, order_token ORDER BY source_rnk ASC, idv_date DESC) = 1
                )
      , loans     AS
            (
                SELECT token
                     , loan_details_loan_id
                     , consumer_consumer_uuid
                     , order_transaction_id
                FROM ap_raw_green.green.raw_c_e_order
                WHERE payment_type = 'PCL'
                  AND status = 'APPROVED'
                QUALIFY ROW_NUMBER() OVER (PARTITION BY order_transaction_id ORDER BY event_info_event_time DESC) = 1
                )
      , principal AS
            (
                SELECT CAST(a.key_loan_id AS STRING) key_loan_id
                     , b.id                          order_id
                     , a.origination_date
                     , a.originated_principal
                     , a.interest_cap
                     , a.country_code
                     , status
                     , b.order_date
                     , b.consumer_amount
                     , b.first_payment_up_front
                FROM ap_raw_green.green.raw_c_e_loanservice_loan                             a
                         JOIN ap_raw_green.green.raw_c_f_aurora_paylater_consumer_order_loan c
                              ON a.key_loan_id = c.key_loan_id
                         JOIN ap_raw_green.green.f_order                                     b
                              ON c.key_order_transaction_id = b.id
                WHERE status = 'IN_PROGRESS'
                  AND origination_date = '2025-04-01'
                QUALIFY RANK() OVER (PARTITION BY a.key_loan_id ORDER BY a.event_info_event_time DESC) = 1
                )
      , invoiced  AS
            (
                SELECT a.id instalment_id
                     , a.gdp_region
                     , a.order_id
                     , a.original_due_date
                     , b.order_token
                     , a.amount
                     , b.order_date
                FROM ap_raw_green.green.f_instalment     a
                         JOIN ap_raw_green.green.f_order b
                              ON a.order_id = b.id
                WHERE b.country_code = 'US'
                  AND b.payment_type = 'PCL'
                QUALIFY ROW_NUMBER() OVER ( PARTITION BY a.order_id, a.gdp_region ORDER BY a.original_due_date ASC ) = 2
                )
      , xo        AS
            (
                SELECT transaction_token
                     , transaction_date
                     , dropout_reason
                     , uuid
                FROM ap_cur_xoop_g.pay_monthly.m_atm_attempt_master
                WHERE customer_country = 'US'
                )
      , fsc1      AS
            (
                SELECT order_token
                     , consumer_id
                     , var_value fraud_score_1
                --from AP_CUR_R_FEATSCI.CURATED_FEATURE_SCIENCE_RED.RAW_C_E_FC_DECISION_RECORD_RULE_VARS_RT__OKASPERSKA_DSL3_SV -- this table only has last 3 days
                FROM ap_cur_r_featsci.curated_feature_science_red.tbl_raw_c_e_fc_decision_record_rule_vars__okasperska_DSL3_SV
                WHERE par_region = 'US'
                  AND checkpoint IN ('CHECKOUT_CONFIRM')
                  AND var_name IN ('model_online_od_abusive_global_april_2024_score')
                  AND par_process_date = '2025-04-01'
                QUALIFY ROW_NUMBER() OVER (PARTITION BY consumer_id, order_token ORDER BY event_info_event_time DESC) = 1
                )
      , fsc2      AS
            (
                SELECT order_token
                     , consumer_id
                     , var_value fraud_score_2
                --from AP_CUR_R_FEATSCI.CURATED_FEATURE_SCIENCE_RED.RAW_C_E_FC_DECISION_RECORD_RULE_VARS_RT__OKASPERSKA_DSL3_SV
                FROM ap_cur_r_featsci.curated_feature_science_red.tbl_raw_c_e_fc_decision_record_rule_vars__okasperska_DSL3_SV
                WHERE par_region = 'US'
                  AND checkpoint IN ('CHECKOUT_CONFIRM')
                  AND var_name IN ('model_online_cb_model_global_june_2024_score')
                  AND par_process_date = '2025-04-01'
                QUALIFY ROW_NUMBER() OVER (PARTITION BY consumer_id, order_token ORDER BY event_info_event_time DESC) = 1
                )

    SELECT 'Block'                                                                                                                                                AS partner_id
         , base.order_token -- keep commented out in case needed for troubleshooting
