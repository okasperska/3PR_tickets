CREATE OR REPLACE TABLE cash_3pr_pii.afterpay.feb_de_applications_daily AS
(
    WITH
        base AS (
            SELECT *
            FROM cash_3pr_pii.afterpay.feb_de_applications_idv
            UNION
            SELECT *
            FROM cash_3pr_pii.afterpay.feb_de_applications_crd
            )
    SELECT *
         , CURRENT_TIMESTAMP AS report_generated_date
    FROM base
    );

CREATE TABLE IF NOT EXISTS cash_3pr_pii.afterpay.feb_de_applications LIKE cash_3pr_pii.afterpay.feb_de_applications_daily;

/*
 Merges monthly report into the historical table, if the unique_transaction_id doesn't exist in the historical table, it will insert it.
 If the application_id exists in the historical table, but any of the fields have changed, it will insert an additional row with the new data.
 PK for the historical table is application_id, report_generated_date
 */
-- Step 1: Insert non-existing rows
INSERT INTO cash_3pr_pii.afterpay.feb_de_applications
SELECT DISTINCT source.*
FROM cash_3pr_pii.afterpay.feb_de_applications_daily source
WHERE NOT EXISTS
      (
          SELECT 1
          FROM cash_3pr_pii.afterpay.feb_de_applications target
          WHERE target.application_id = source.application_id
          );

-- Step 2: Insert changed rows
INSERT INTO cash_3pr_pii.afterpay.feb_de_applications
SELECT DISTINCT source.*
FROM cash_3pr_pii.afterpay.feb_de_applications_daily    source
         JOIN cash_3pr_pii.afterpay.feb_de_applications target
              ON source.application_id = target.application_id AND source.report_generated_date > target.report_generated_date
WHERE (
          source.partner_id <> target.partner_id OR
              source.loan_account_number <> target.loan_account_number OR
              source.customer_id <> target.customer_id OR
              source.first_name <> target.first_name OR
              source.last_name <> target.last_name OR
              source.ssn_or_fedid <> target.ssn_or_fedid OR
              source.date_of_birth <> target.date_of_birth OR
              source.street_address1 <> target.street_address1 OR
              source.street_address2 <> target.street_address2 OR
              source.city <> target.city OR
              source.state <> target.state OR
              source.zipcode_plus_four <> target.zipcode_plus_four OR
              source.ability_to_pay_measurement_value <> target.ability_to_pay_measurement_value OR
              source.ability_to_pay_result <> target.ability_to_pay_result OR
              source.active_duty_flag <> target.active_duty_flag OR
              source.address_discrepancy_alert <> target.address_discrepancy_alert OR
              source.adverse_action_notice_date <> target.adverse_action_notice_date OR
              source.adverse_action_reason_1 <> target.adverse_action_reason_1 OR
              source.adverse_action_reason_2 <> target.adverse_action_reason_2 OR
              source.adverse_action_reason_3 <> target.adverse_action_reason_3 OR
          );
